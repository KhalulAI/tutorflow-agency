DATABASE_URL=postgresql://user:password@localhost:5432/tutorflow
POSTMARK_SERVER_TOKEN=POSTMARK_API_TEST
POSTMARK_FROM_EMAIL=verified-sender@example.com
POSTMARK_MESSAGE_STREAM=outbound
